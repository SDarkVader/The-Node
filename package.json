{
  "name": "the-node",
  "version": "0.1.0",
  "private": true,
  "description": "NODE \u2014 persistent multiplayer social-economic game engine",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:session-recovery": "node --test test/sessionRecovery.test.mjs",
    "recovery:verify": "node scripts/session-recovery.mjs verify",
    "recovery:capture": "node scripts/session-recovery.mjs capture",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sim": "tsx src/sim/cli.ts",
    "vacancy-sim": "tsx src/sim/vacancyCli.ts",
    "conscription-sim": "tsx src/sim/conscriptionCli.ts",
    "ecosystem-sim": "tsx src/sim/ecosystemCli.ts",
    "sabotage-pattern-sim": "tsx src/sim/sabotagePatternCli.ts",
    "arson-sim": "tsx src/sim/arsonCli.ts",
    "experience-floor-sim": "tsx src/sim/experienceFloorCli.ts",
    "eviction-protection-sim": "tsx src/sim/evictionProtectionCli.ts",
    "oracle-sim": "tsx src/sim/oracleCli.ts",
    "settlement-report": "tsx src/sim/settlementReport.ts",
    "eval:bridge": "tsx src/eval/bridge.ts",
    "sabotage-campaign-sim": "tsx src/sim/sabotageCampaignCli.ts",
    "playtest": "tsx src/sim/playtestCli.ts",
    "web-export": "tsx src/sim/webExportCli.ts",
    "level-two-reachability-sim": "tsx src/sim/levelTwoReachabilityCli.ts",
    "spatial-witness-report": "tsx src/sim/spatialWitnessReport.ts",
    "world-sim": "tsx src/sim/worldCli.ts",
    "role-ratio-sweep": "tsx src/sim/roleRatioSweep.ts",
    "district-role-sweep": "tsx src/sim/districtRoleSweep.ts",
    "recognition-v2-sim": "tsx src/sim/recognitionV2Report.ts",
    "multi-shard-role-district-sweep": "tsx src/sim/multiShardRoleDistrictSweep.ts",
    "wealth-inequality-report": "tsx src/sim/wealthInequalityReport.ts",
    "shard-identity-report": "tsx src/sim/shardIdentityReport.ts",
    "resource-report": "tsx src/sim/resourceReport.ts",
    "district-layout-comparison": "tsx src/sim/districtLayoutComparison.ts",
    "joint-grid-search": "tsx src/sim/jointGridSearch.ts",
    "multi-shard-equilibrium-sweep": "tsx src/sim/multiShardEquilibriumSweep.ts",
    "multi-shard-validation": "tsx src/sim/multiShardValidation.ts",
    "identity-resolution-report": "tsx src/sim/identityResolutionReport.ts",
    "throttle-window-report": "tsx src/sim/throttleWindowReport.ts",
    "population-capacity-sweep": "tsx src/sim/populationCapacitySweep.ts",
    "driver-heterogeneity-sweep": "tsx src/sim/driverHeterogeneitySweep.ts",
    "mvp": "tsx src/mvp/run.ts",
    "server": "tsx src/server/ws.ts",
    "observatory": "tsx src/observatory/cli.ts",
    "observatory:demo": "tsx scripts/observatory-demo.ts",
    "observatory:evaluate": "tsx scripts/evaluate-observatory.ts",
    "continuation:preflight": "tsx scripts/continuation-preflight.ts",
    "test:observatory": "vitest run test/observatory.test.ts test/anthropicNodeWorker.test.ts test/clientProtocolConformance.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "ws": "^8.21.2"
  }
}
