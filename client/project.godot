; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NODE"
; The real settlement view (2026-08-19). scenes/Main.tscn is the older MVP-scenario
; scaffold and still works against `NODE_LEGACY_MVP=1 npm run server`.
run/main_scene="res://scenes/IsoView.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=800

[rendering]

; Ember's ground tone (13,10,8). Without this the area outside the settlement renders in
; Godot's default grey, which breaks the palette everywhere the town does not reach —
; found by actually screenshotting a headless run, not by reading the code.
environment/defaults/default_clear_color=Color(0.051, 0.039, 0.031, 1)
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
